Table attendance_logs {
  id "bigint(20) unsigned" [pk, not null, increment]
  employee_id "bigint(20) unsigned" [not null]
  attendance_date date [not null]
  time_in time [null, default: null]
  time_out time [null, default: null]
  method_in attendance_logs_method_in_enum [null, default: null]
  method_out attendance_logs_method_out_enum [null, default: null]
  late_minutes "int(10) unsigned" [not null, default: 0]
  undertime_minutes "int(10) unsigned" [not null, default: 0]
  total_hours decimal(8,4) [not null, default: 0.0000]
  status attendance_logs_status_enum [not null, default: 'incomplete']
  remarks text [null, default: null]
  created_at timestamp [null, default: null]
  updated_at timestamp [null, default: null]
  faculty_schedule_id "bigint(20) unsigned" [null, default: null]
  subject varchar(255) [null, default: null]
  section varchar(100) [null, default: null]
  scheduled_start time [null, default: null]
  scheduled_end time [null, default: null]
  worked_seconds "int(10) unsigned" [not null, default: 0]
  legacy_source_id "bigint(20) unsigned" [null, default: null]
  is_legacy tinyint(1) [not null, default: 1]
  class_mode varchar(20) [null, default: null]

  indexes {
    (employee_id, attendance_date, faculty_schedule_id) [unique, name: 'attendance_class_unique']
    employee_id [name: 'attendance_employee_session_index']
    faculty_schedule_id [name: 'attendance_logs_faculty_schedule_id_index']
    legacy_source_id [name: 'attendance_logs_legacy_source_id_index']
  }
}

